<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F8FD">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLibraryBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="36sp"
                    android:textColor="#17251A"
                    android:background="@drawable/bg_white_round"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 Kho đề của tôi"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#202420"/>

                    <TextView
                        android:id="@+id/txtLibrarySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 bộ đề tự tạo sẵn sàng luyện tập"
                        android:textSize="13sp"
                        android:textColor="#6B716B"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddQuiz"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="36sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_green_circle"/>
            </LinearLayout>

            <!-- SEARCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_white_round">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textSize="30sp"
                    android:textColor="#9CA5A0"/>

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:hint="Tìm kiếm bộ đề trong kho..."
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:background="@android:color/transparent"/>

                <TextView
                    android:id="@+id/btnSearchFilter"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="☷"
                    android:textSize="25sp"
                    android:textColor="#35443A"/>
            </LinearLayout>

            <!-- FILTER -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filterAllQuizzes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả bộ đề"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="13dp"
                        android:background="@drawable/bg_green_pill"/>

                    <TextView
                        android:id="@+id/filterAiQuizzes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="✨ AI tạo"
                        android:textColor="#343A35"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="13dp"
                        android:background="@drawable/bg_white_round"/>

                    <TextView
                        android:id="@+id/filterWordQuizzes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="📁 Tệp Word"
                        android:textColor="#343A35"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="13dp"
                        android:background="@drawable/bg_white_round"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh sách bộ đề"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#222722"/>

                <TextView
                    android:id="@+id/txtQuizCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 bộ đề"
                    android:textStyle="bold"
                    android:textColor="#1D5C16"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:background="@drawable/bg_light_green_pill"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/libraryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"/>

            <!-- ZIPPY AI BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_ai_banner">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🤖"
                    android:textSize="28sp"
                    android:background="@drawable/bg_green_circle"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tạo thêm bộ đề với Zippy AI"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#202920"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tải file PDF, Word hoặc nhập chủ đề tức thì"
                        android:textSize="12sp"
                        android:textColor="#6D766D"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCreateNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Tạo ngay"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_green_pill"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navLibraryHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nTrang chủ"
            android:textSize="12sp"
            android:textColor="#84908A"/>

        <TextView
            android:id="@+id/navLibraryHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nĐã luyện"
            android:textSize="12sp"
            android:textColor="#84908A"/>

        <TextView
            android:id="@+id/navLibraryAdd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="+"
            android:textSize="36sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_green_circle"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▱\nKho đề"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#22601D"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nCá nhân"
            android:textSize="12sp"
            android:textColor="#84908A"/>
    </LinearLayout>
</LinearLayout>
